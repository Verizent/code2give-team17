node_modules/

# Secrets. Every real .env stays local; only the .example files are tracked.
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/

# Logs
*.log

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Claude Code local state and per-teammate operator context.
# CLAUDE.md, CONTEXT.md and everything under .claude/ are per-machine only — they carry
# agent scratch state and operator preferences, and tracking them creates merge noise on
# every session. Persistent shared docs live under docs/ and SERVER_README.md.
.claude/
CLAUDE.md
CONTEXT.md

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Git worktrees live inside the repo dir; they must never be tracked.
# worktree-frontend was committed as an orphan 160000 gitlink with no .gitmodules,
# which breaks `git clone` for everyone else.
worktree-frontend/
