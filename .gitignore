# dependencies
node_modules/

# next.js (legacy root app, if present)
.next/
out/

# Build output
build/
dist/
dist-ssr/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets. Every real .env stays local; only the .example files are tracked.
.env
.env.*
!.env.example

# vercel / typescript
.vercel
*.tsbuildinfo
next-env.d.ts

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Claude Code local state — per-machine permission grants, not shared.
# .claude/rules/ IS tracked; only this file is ignored.
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
