# Secrets. Every real .env stays local; only the .example files are tracked.
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/

# Logs
*.log

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Claude Code local state and per-teammate operator context.
# CLAUDE.md, CONTEXT.md and everything under .claude/ are per-machine only —
# they carry agent scratch state and operator preferences, and tracking them
# creates merge noise on every session. Persistent shared docs live under docs/.
CLAUDE.md
CONTEXT.md
.claude/

