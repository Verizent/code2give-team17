{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API for the Code2Give Team 17 web app",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node db/seed/seed.js",
    "seed:admin": "node db/seed/admin.seed.js",
    "seed:analytics": "node db/seed/analytics.seed.js",
    "seed:volunteer-attendance": "node db/seed/volunteer-attendance.seed.js",
    "seed:volunteer-history": "node db/seed/volunteer-history.seed.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:schema": "node --test --test-concurrency=1 \"test/schema/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  }
}
