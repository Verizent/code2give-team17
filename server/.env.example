# Server environment. Copy to server/.env and fill in.
# server/.env holds live secrets and is gitignored — never commit it.

# --- Runtime ---
HOST=0.0.0.0
PORT=3000
# Must match the browser origin exactly or the CORS middleware blocks every request.
CLIENT_ORIGIN=http://localhost:5173
# Anything other than `development` suppresses `message` on EVERY error, leaving
# `{ error, code }` (CONTEXT.md §29). Keep it `development` locally or every
# failure goes blind — including the 400s a form needs to display.
NODE_ENV=development

# --- Supabase --- (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key. Bypasses RLS, so it is server-only and must never be
# VITE_-prefixed or sent to the browser (§9). The frontend never queries
# Supabase directly; it uses the anon key for Auth alone — see client/.env.example.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Analytics --- (§23)
# HMAC salt for the daily-rotating visitor hash. Any long random value;
# changing it resets visitor identity. Generate with: openssl rand -hex 32
SERVER_SECRET=

# --- Stripe — TEST MODE ONLY --- (§17, §18.6)
# A live key must never appear here. Test keys start `sk_test_`, and src/lib/stripe.js
# refuses to build a client with anything else rather than trusting this comment.
STRIPE_SECRET_KEY=sk_test_***
# Printed by: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Starts `whsec_`. Without it POST /api/webhooks/stripe 500s, so the donation stays
# `pending` and never credits — the webhook is what marks it succeeded.
STRIPE_WEBHOOK_SECRET=

# --- Resend --- (§17)
# The sandbox domain only delivers to our own verified addresses until DNS on
# love21foundation.com is verified, so email is not a demo dependency.
#
# `log`  — renders every send to stdout with a visible banner. The default, and what
#          the demo runs on: POST /api/admin/cron/close-periods prints the batch email
#          to the server terminal where a demoer can show it on stage.
# `send` — throws. The real Resend call is deliberately unimplemented; wiring it before
#          DNS verification would fail silently for every address except our own.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- HandsOn Hong Kong --- (§17)
# `mock` answers from seeded data (the stub). `live` is unimplemented and throws.
HANDSON_MODE=mock
HANDSON_BASE_URL=
HANDSON_API_KEY=

# --- Demo bypass --- (DEMO-ONLY, dev-only, §19)
# Set to a real profiles.id (typically the demo admin from `npm run seed:admin`).
# When set AND NODE_ENV=development, requests carrying the header
# `X-Demo-Auth: admin` resolve to that profile without a Supabase JWT. This is
# a hard-blocked no-op in any other NODE_ENV, and a no-op without the header.
# NEVER set this in production — it exists because the demo predates the
# frontend sign-in flow.
DEMO_ADMIN_USER_ID=

# --- Auth / Email seams (volunteer track) --- DEMO-ONLY (§26)
AUTH_MODE=stub
EMAIL_MODE=console

# Email verification (volunteer track)
EMAIL_VERIFICATION_SECRET=change-me-in-production
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30

# DEMO-ONLY. When "true", a Voices submission is published straight to the Community
# wall instead of waiting in the moderation queue. Exists so the submit-to-visible flow
# can be shown without an admin login mid-demo. Must be absent or "false" anywhere real
# people can reach the form — it is the only thing keeping unreviewed anonymous text and
# images off a public page.
VOICES_AUTO_APPROVE=false
