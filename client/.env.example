# Client environment. Copy to client/.env.local (gitignored).
# Every VITE_-prefixed value compiles into the public bundle — treat as public.

# vite.config.js proxies /api to localhost:3000 in dev, so this can stay relative.
VITE_API_BASE_URL=/api

# apiClient's mock/real seam. `mock` uses lib/mock.js fixtures so the app never
# depends on the server being up; `real` calls the Express API. Cutover is this
# flag, not a refactor.
VITE_API_MODE=mock
