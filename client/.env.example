# Client environment. Copy to client/.env.local (gitignored via `*.local`).
#
# WARNING — every VITE_-prefixed variable is compiled into the public bundle and
# is readable by anyone who opens devtools. Treat all of them as public. The
# Supabase service-role key and every Stripe secret belong in server/.env,
# never here (CONTEXT.md §28).

# Leave empty in dev — call sites use `/api/...` and vite.config.js proxies
# `/api` → localhost:3000. Setting this to `/api` would double-prefix paths.
VITE_API_BASE_URL=
# Optional absolute host when not using the Vite proxy (apiClient joins `/api/...`).
VITE_API_URL=http://localhost:3000

# apiClient mock/real seam (§12). Prefer `real` for volunteer listings.
# `mock` uses client fixtures for Home impact / Community share when the API
# is down — cutover is this flag, not a refactor.
VITE_API_MODE=real

# DEMO-ONLY: `true` reaches /admin with no login by sending `X-Demo-Auth: admin`,
# which the server honours only when NODE_ENV=development and DEMO_ADMIN_USER_ID
# are both set (server/.env). Ignored entirely in a production build — the flag is
# ANDed with Vite's DEV, so `vite build` cannot ship it. Leave unset to require a
# real Supabase login.
VITE_ADMIN_AUTH_BYPASS=false

# Supabase Auth ONLY — the frontend never queries Supabase directly (§9).
# The anon key is designed to be public and is constrained by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key (test mode). Secret keys stay on the server.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Instagram embeds on /admin/instagram (official embed.js — publish in Instagram itself).
# Profile defaults to https://www.instagram.com/love21foundation/ when unset.
VITE_INSTAGRAM_PROFILE_URL=https://www.instagram.com/love21foundation/
# Optional comma-separated post permalinks for in-page embeds.
# VITE_INSTAGRAM_POST_URLS=https://www.instagram.com/p/EXAMPLE1/,https://www.instagram.com/p/EXAMPLE2/
